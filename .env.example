# ไฟล์ตัวอย่าง environment variables — ห้าม commit ค่าจริง
# คัดลอกเป็น .env แล้วกรอกค่าจริงก่อนรัน

# Fernet key 32 bytes base64-encoded — สร้างด้วย: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETCONFIG_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Path ไฟล์ SQLite (สัมพัทธ์จาก backend/)
NETCONFIG_DB_PATH=./netconfig.db

# Host/port ของ backend
NETCONFIG_HOST=127.0.0.1
NETCONFIG_PORT=8000

# CORS origins ที่อนุญาต (คั่นด้วยเครื่องหมาย comma)
NETCONFIG_CORS_ORIGINS=http://localhost:5173
